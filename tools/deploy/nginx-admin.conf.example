# 放在已有 HTTPS server 块内。面板为静态文件，接口由 Gateway 自行校验 Authorization。
root /var/www/metamystia-admin;
index index.html;

location = / {
    try_files /index.html =404;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-cache always;
}
location / {
    try_files $uri =404;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-cache always;
}
location = /admin/ { return 302 /; }
location /admin/ {
    proxy_pass http://127.0.0.1:40900;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host $host;
    proxy_cache off;
}
