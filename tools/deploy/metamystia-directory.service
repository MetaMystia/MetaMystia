[Unit]
Description=MetaMystia server directory
After=network.target

[Service]
Type=simple
User=metamystia
Group=metamystia
WorkingDirectory=/opt/metamystia-hosting/directory
EnvironmentFile=/etc/metamystia-hosting/directory.env
ExecStart=/opt/metamystia-hosting/directory/MetaMystia.Directory
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/metamystia-hosting/data

[Install]
WantedBy=multi-user.target
