# 只读接口域名：只转发 /api/，管理接口不经此域名。证书沿用已有 HTTPS 站点的配置。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.metamystia.net;

    location /api/ {
        proxy_pass http://127.0.0.1:40900;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_cache off;
        # 长轮询最多等待 60 秒。
        proxy_read_timeout 90s;
    }
    location / { return 404; }
}
