[Unit]
Description=MetaMystia TCP gateway
After=network.target

[Service]
Type=simple
User=metamystia
Group=metamystia
WorkingDirectory=/opt/metamystia-hosting/gateway
EnvironmentFile=/etc/metamystia-hosting/gateway.env
ExecStart=/opt/metamystia-hosting/gateway/MetaMystia.Gateway
Restart=no
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/metamystia-hosting/data

[Install]
WantedBy=multi-user.target
