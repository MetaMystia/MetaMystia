<Project Sdk="Mystia.Extension.Sdk/2.0.0">
  <Import Project="../../MetaMystia.local.props" Condition="Exists('../../MetaMystia.local.props')" />
  <Import Project="../../Versions.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MetaMystia</AssemblyName>
    <Product>MetaMystia</Product>
    <RootNamespace>MetaMystia</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);TMI_$(TargetGameVersion.Replace(' ', '_').Replace('.', '_').ToUpperInvariant())</DefineConstants>
  </PropertyGroup>

  <Target Name="GenerateTargetGameVersion" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)TargetGameVersion.g.cs"
      Lines="namespace MetaMystia { internal static class TmiBuildInfo { internal const string TargetGameVersion = &quot;$(TargetGameVersion)&quot;%3B internal const string ModVersion = &quot;$(Version)&quot;%3B internal const string ModId = &quot;MetaMystia&quot;%3B } }"
      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)TargetGameVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- 幽幽子挑战相关文件已按 4.4.0e 互操作成员布局完成适配，不再排除编译。 -->

  <ItemGroup>
    <!-- 交给 MetaMystia.Generators 在编译期内联成 LocaleResources 常量，运行时不再读嵌资。 -->
    <AdditionalFiles Include="UI\Locales\en.json" />
    <AdditionalFiles Include="UI\Locales\zh-CN.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MetaMystia.Network/MetaMystia.Network.csproj" />
    <ProjectReference Include="../MetaMystia.Generators/MetaMystia.Generators.csproj"
      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <!-- 模组侧仍直接使用 Il2Cpp 壳类型（L10n/委托等），共享网络层不再带这个依赖。 -->
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
</Project>
