<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../MetaMystia.Network/Network.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 本工程直接编译模组源码（GameInterop 别名），是除模组本体外唯一需要游戏互操作的工程。 -->
    <Reference Include="Assembly-CSharp" Aliases="GameInterop" Private="true">
      <HintPath>$(MystiaInteropDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib" Private="true">
      <HintPath>$(MystiaInteropDir)Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Private="true">
      <HintPath>$(MystiaInteropDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <ProjectReference Include="../MetaMystia.Network/MetaMystia.Network.csproj" />
    <Compile Include="../MetaMystia.Mod/Managers/DayDestinationManager.cs" Link="DayDestinationManager.cs" />
    <Compile Include="../MetaMystia.Mod/Managers/BusinessStart.cs" Link="BusinessStart.cs" />
    <Compile Include="../MetaMystia.Mod/Managers/GameFlow.Transitions.cs" Link="GameFlow.Transitions.cs" />
    <Compile Include="../MetaMystia.Mod/Listeners/PrepSync.cs" Link="PrepSync.cs" />
    <Compile Include="../MetaMystia.Mod/UI/PlayerPresenceNotice.cs" Link="PlayerPresenceNotice.cs" />
  </ItemGroup>
</Project>
