<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="MetaMystia.local.props" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <AssemblyName>MetaMystia</AssemblyName>
    <Product>MetaMystia</Product>
    <Version>0.26.6</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>MetaMystia</RootNamespace>
    <OutputPath>$(BepInExPath)\plugins</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <Target Name="RenameBuildOutput" AfterTargets="Build">
    <PropertyGroup>
      <RenamedAssembly>$(AssemblyName)-v$(Version)</RenamedAssembly>
      <RenamedAssemblyPath>$(OutputPath)$(RenamedAssembly)</RenamedAssemblyPath>
    </PropertyGroup>
    <Move SourceFiles="$(TargetPath)" DestinationFiles="$(RenamedAssemblyPath)$(TargetExt)" />
    <Message Text="Renamed $(TargetPath) to $(RenamedAssemblyPath)$(TargetExt)" Importance="High" />
  </Target>

  <Target Name="PatchIl2CppInteropHarmonySupport" AfterTargets="Build">
    <Copy SourceFiles="Patches\Native\Runtime\Il2CppInterop.HarmonySupport.dll"
      DestinationFolder="$(BepInExPath)\core"
      SkipUnchangedFiles="true" />
    <Message Text="Patched Il2CppInterop.HarmonySupport.dll → $(BepInExPath)\core"
      Importance="High" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Patches\Native\Runtime\Il2CppInterop.HarmonySupport.dll" />
    <EmbeddedResource Include="Debugger\login.html" />
    <EmbeddedResource Include="Debugger\index.html" />
    <EmbeddedResource Include="ResourceEx\AssetManagement\public.pem" />
    <EmbeddedResource Include="UI\Locales\en.json" />
    <EmbeddedResource Include="UI\Locales\zh-CN.json" />
    <EmbeddedResource Remove="LogGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MetaMystia.Generators\MetaMystia.Generators.csproj"
      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Network\Protocol\**" />
    <EmbeddedResource Remove="Network\Protocol\**" />
    <None Remove="Network\Protocol\**" />
    <Compile Remove="MetaMystia.Protocol\**" />
    <EmbeddedResource Remove="MetaMystia.Protocol\**" />
    <None Remove="MetaMystia.Protocol\**" />
    <Compile Remove="MetaMystia.Generators\**" />
    <EmbeddedResource Remove="MetaMystia.Generators\**" />
    <None Remove="MetaMystia.Generators\**" />
    <Compile Remove="LogGenerator\**" />
    <None Remove="LogGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MystiaReverse\**" />
    <EmbeddedResource Remove="MystiaReverse\**" />
    <None Remove="MystiaReverse\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MetaMystia.Generators\**" />
    <EmbeddedResource Remove="MetaMystia.Generators\**" />
    <None Remove="MetaMystia.Generators\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DebugImpl\**" />
    <EmbeddedResource Remove="DebugImpl\**" />
    <None Remove="DebugImpl\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="meta-mystia-network\**" />
    <EmbeddedResource Remove="meta-mystia-network\**" />
    <None Remove="meta-mystia-network\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="Costura.Fody" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
      <Private>False</Private>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MemoryPack" Version="1.21.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLua" Version="1.7.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="KeraLua" Version="1.4.9" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgKeraLua)\runtimes\win-x64\native\lua54.dll">
      <Link>costura-win-x64\lua54.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

